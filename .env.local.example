# Turso (libsql) — https://turso.tech
# Local dev: leave both unset to use a local SQLite file (local.db)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Forward-to-us inbound email (see workers/inbound-email/README.md)
# Shared secret guarding /api/inbound — must match the Worker's INBOUND_SECRET.
INBOUND_SECRET=a-long-random-string

# Show the "forward it to us" UI. Leave unset until inbound mail is live.
NEXT_PUBLIC_INBOUND_ENABLED=false
# Address users forward to (optional; defaults to check@veriguard.app).
NEXT_PUBLIC_INBOUND_ADDRESS=check@veriguard.app

# Signs the report form's render timestamp (see lib/formToken.ts), so the
# anti-bot timing check measures a value the client cannot choose.
# REQUIRED in any real deployment. Generate with: openssl rand -hex 32
REPORT_FORM_SECRET=a-long-random-string

# Cross-origin access to /api/check (see lib/cors.ts)
# Comma-separated list of origins allowed to call the API from a browser.
# The site's own origin is always allowed and does not need listing here.
#
# LEAVE UNSET unless a non-web client exists. Empty is the safe default and
# matches the behaviour before CORS existed: only the site itself can call the
# API cross-origin.
#
# This is where a browser-extension origin goes once the extension is published
# — the id is assigned at packaging time, so it cannot be hardcoded. Never use
# a wildcard or a scheme-only pattern: "any chrome-extension://" would let every
# extension on a user's machine call this API with that user's IP.
#
# CORS_ALLOWED_ORIGINS=chrome-extension://abcdefghijklmnopqrstuvwxyzabcdef,moz-extension://11111111-2222-3333-4444-555555555555

# Site-wide service notice (maintenance, a degraded feature, an incident).
# Set to "true" to show the strip under the header; unset it to remove.
# NEXT_PUBLIC_SERVICE_NOTICE=true
# Which message to show — a key in messages/, not free text, so the copy stays
# translatable and an env var can never inject markup. Defaults to
# service.inboundDelayed.
# NEXT_PUBLIC_SERVICE_NOTICE_KEY=service.inboundDelayed
