# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# nested workspaces (e.g. the inbound-email worker) have their own deps
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.vscode/

# local database files (SQLite + WAL/SHM sidecars)
*.db
*.db-shm
*.db-wal
*.db-journal

# Tesseract OCR model — large binary, downloaded at runtime
*.traineddata

# Tesseract browser runtime — copied from node_modules by scripts/copy-ocr-assets.mjs
# (npm run ocr-assets, and automatically on predev/prebuild). Reproducible, so
# not committed; the language data in public/tessdata/ IS committed because it
# ships with no package we depend on.
/public/tesseract/

# dev/audit scripts that aren't part of the app
audit.mjs

# Throwaway probe files written by __tests__/engineNetworkImports.test.ts when
# it lints a real repo path against the real config. Removed in a finally, but
# an interrupted run must not leave a committable rule-violating file behind.
__privacy_probe__.ts
__privacy_probe__.tsx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# built WebExtension bundles — reproducible from source via `npm run ext`.
# The unpacked build is what you load in the browser; the store uploads are
# zipped from it. Neither is source.
/extension/dist/

# extension icons — generated from app/icon.svg by `npm run icons`, same as the
# PWA set. Committing them would be a second copy of the mark to keep in step.
/extension/icons/

# the Safari wrapper — an Xcode project generated from extension/dist/chrome by
# `npm run ext:safari`. Regenerated on demand; committing it would mean
# maintaining a second copy of the extension plus a project file that conflicts
# on every merge.
/extension/safari/

# typescript
*.tsbuildinfo
next-env.d.ts
