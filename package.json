{
  "name": "veriguard",
  "version": "0.20.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "predev": "node scripts/copy-ocr-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "NODE_OPTIONS=--disable-warning=DEP0205 vitest run",
    "test:watch": "NODE_OPTIONS=--disable-warning=DEP0205 vitest",
    "seed": "NODE_OPTIONS=--disable-warning=DEP0205 npx tsx scripts/seed-db.ts",
    "region-demand": "NODE_OPTIONS=--disable-warning=DEP0205 npx tsx scripts/region-demand.ts",
    "check-calendar": "NODE_OPTIONS=--disable-warning=DEP0205 npx tsx scripts/check-calendar-sources.ts",
    "check-promotion": "NODE_OPTIONS=--disable-warning=DEP0205 npx tsx scripts/check-promotion-freshness.ts",
    "sweep-coverage": "NODE_OPTIONS=--disable-warning=DEP0205 npx tsx scripts/sweep-coverage.ts",
    "check-source-coverage": "NODE_OPTIONS=--disable-warning=DEP0205 npx tsx scripts/check-source-coverage.ts",
    "icons": "node scripts/generate-icons.mjs",
    "psl": "node scripts/generate-psl.mjs",
    "ocr-assets": "node scripts/copy-ocr-assets.mjs",
    "eval": "NODE_OPTIONS=--disable-warning=DEP0205 npx tsx scripts/eval.ts",
    "eval:metamorphic": "NODE_OPTIONS=--disable-warning=DEP0205 npx tsx scripts/eval-metamorphic.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@veriguard/engine": "*",
    "jsqr": "^1.4.0",
    "next": "^16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.4",
    "js-yaml": "^4.3.2"
  },
  "allowScripts": {
    "unrs-resolver": true,
    "tesseract.js": false
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead",
    "iOS >= 15"
  ],
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
